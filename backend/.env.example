# Copy to .env then run: set -a; source .env; set +a
# (On PowerShell set the variables manually)

# --- PostgreSQL ---
POSTGRES_DB=coding_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Frontend origins allowed to call the API (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
